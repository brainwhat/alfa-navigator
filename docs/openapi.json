  "components": {
    "schemas": {
      "ApplicationInput": {
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Company"
          },
          "purpose": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Purpose"
          },
          "amount": {
            "type": "integer",
            "maximum": 20000000.0,
            "minimum": 100000.0,
            "title": "Amount"
          },
          "months": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 6.0,
            "title": "Months"
          },
          "revenue": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Revenue"
          },
          "available_cashflow": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Available Cashflow"
          },
          "existing_payments": {
            "type": "integer",
            "maximum": 1000000000.0,
            "minimum": 0.0,
            "title": "Existing Payments"
          },
          "overdue": {
            "type": "boolean",
            "title": "Overdue",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "company",
          "purpose",
          "amount",
          "months",
          "revenue",
          "available_cashflow",
          "existing_payments"
        ],
        "title": "ApplicationInput"
      },
      "Clarification": {
        "properties": {
          "available_cashflow": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Available Cashflow"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "available_cashflow",
          "note"
        ],
        "title": "Clarification"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginInput": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "client",
              "bank"
            ],
            "title": "Role"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "role",
          "password"
        ],
        "title": "LoginInput"
      },
      "RequestInfo": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "RequestInfo"
      },
      "SimulationInput": {
        "properties": {
          "amount": {
            "type": "integer",
            "maximum": 20000000.0,
            "minimum": 100000.0,
            "title": "Amount"
          },
          "months": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 6.0,
            "title": "Months"
          },
          "available_cashflow": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Available Cashflow"
          },
          "existing_payments": {
            "type": "integer",
            "maximum": 1000000000.0,
            "minimum": 0.0,
            "title": "Existing Payments"
          },
          "seasonality": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Seasonality",
            "description": "Процент сезонного падения свободного потока"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "months",
          "available_cashflow",
          "existing_payments",
          "seasonality"
        ],
        "title": "SimulationInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}