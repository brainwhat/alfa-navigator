{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "excludeFiles": "{.github/**,docs/**,tests/**,e2e/**,scripts/**,Dockerfile,docker-compose.yml,.venv/**,.data/**,.claude/**,.env*,.pytest_cache/**,**/__pycache__/**,**/*.db}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
